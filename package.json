{
  "name": "tamakey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "wrangler pages deploy dist --project-name=tamakey",
    "pages:dev": "pnpm build && wrangler pages dev dist",
    "pages:deploy": "pnpm build && wrangler pages deploy dist --project-name=tamakey",
    "lint": "eslint . --ignore-pattern 'dev-dist/**' --ignore-pattern 'dist/**' --ignore-pattern 'test-results/**'",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm e2e",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.18",
    "pixi.js": "^8.18.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260507.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.89.1"
  }
}
